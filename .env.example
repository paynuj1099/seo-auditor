# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Rate Limiting (simple in-memory for MVP, can be replaced with Redis/Upstash in production)
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MS=900000

# Screenshot Storage (local for development, can be configured for S3/R2/Vercel Blob in production)
SCREENSHOT_STORAGE_PATH=./public/screenshots

# Playwright Browser Configuration
PLAYWRIGHT_TIMEOUT=30000
PLAYWRIGHT_MAX_SCREENSHOT_HEIGHT=10000
